<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow" Title="ParcheCAD 4.3 | Firewall AutoCAD y WebView2"
        Width="1050" Height="665" MinWidth="430" MinHeight="300"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#10264B"/>
  <SolidColorBrush x:Key="Muted" Color="#52657E"/>
  <SolidColorBrush x:Key="Accent" Color="#1769D2"/>
  <SolidColorBrush x:Key="Line" Color="#E5EAF3"/>
  <SolidColorBrush x:Key="Success" Color="#0C7140"/>
  <SolidColorBrush x:Key="Subtle" Color="#52657E"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="13"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="17" ShadowDepth="1" Opacity="0.065" Color="#233957"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#1769D2"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="44"/>
   <Setter Property="Padding" Value="10,10"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#DCE6F4" BorderThickness="{TemplateBinding BorderThickness}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#E9EDF4"/><Setter Property="Foreground" Value="#53657E"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="3"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#082E70"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Action}">
   <Setter Property="Background" Value="#EEF4FD"/>
   <Setter Property="Foreground" Value="#234B80"/>
  </Style>
  <Style x:Key="Title" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Meta" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Metric" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </Window.Resources>
 <ScrollViewer x:Name="MainScroll" Background="#F5F7FB"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="15,12,15,12">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="9"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="9"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="9"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="ParcheCAD 4.3" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
     <TextBlock Text="Firewall AutoCAD y auditor WebView2" Style="{StaticResource Meta}"/>
    </StackPanel>
    <Border Grid.Column="1" Background="#E4F4ED" CornerRadius="15" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#15945B" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock x:Name="TopStatus" Text="LISTO" Foreground="#0C7140" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="230"/>
     </StackPanel>
    </Border>
   </Grid>

   <UniformGrid x:Name="MetricsGrid" Grid.Row="2" Columns="4">
    <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="11,8">
     <StackPanel>
      <TextBlock Text="AutoCAD" Style="{StaticResource Meta}"/>
      <TextBlock x:Name="MetricAutoCAD" Text="—" Style="{StaticResource Metric}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="2,0,7,0" Padding="11,8">
     <StackPanel>
      <TextBlock Text="Reglas candidatas" Style="{StaticResource Meta}"/>
      <TextBlock x:Name="MetricRules" Text="—" Style="{StaticResource Metric}"/>
      <TextBlock x:Name="MetricConflicts" Text="Pendiente" Style="{StaticResource Meta}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="2,0,7,0" Padding="11,8">
     <StackPanel>
      <TextBlock Text="WebView2" Style="{StaticResource Meta}"/>
      <TextBlock x:Name="MetricWeb" Text="—" Style="{StaticResource Metric}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="2,0,0,0" Padding="11,8">
     <StackPanel>
      <TextBlock Text="AutoCAD probable" Style="{StaticResource Meta}"/>
      <TextBlock x:Name="MetricProbable" Text="—" Style="{StaticResource Metric}"/>
     </StackPanel>
    </Border>
   </UniformGrid>

   <Border Grid.Row="4" Background="#FFF1D7" CornerRadius="9" Padding="10,7" BorderBrush="#F6DEA7" BorderThickness="1">
    <TextBlock Text="WebView2 es compartido. No se bloquearán sus ejecutables globales." TextWrapping="Wrap" FontSize="12" Foreground="#80501A"/>
   </Border>

   <Border Grid.Row="6" Style="{StaticResource Card}" Padding="13,9">
    <TabControl x:Name="WorkTabs" BorderThickness="0" Background="White" FontSize="13" TabStripPlacement="Top">
     <TabItem Header="Firewall AutoCAD" AutomationProperties.Name="Funciones de firewall AutoCAD">
      <Border x:Name="FirewallCard" Background="White" Padding="6,10,6,0">
       <StackPanel>
        <TextBlock Text="Analiza ejecutables y reglas existentes. No modifica el firewall." Style="{StaticResource Meta}" Margin="0,0,0,9"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="BtnPreview" Grid.Column="0" Style="{StaticResource Action}" AutomationProperties.Name="Analizar firewall AutoCAD, solo lectura">
          <TextBlock Text="ANALIZAR FIREWALL" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
         <Button x:Name="BtnApply" Grid.Column="2" Style="{StaticResource Action}" Background="#0B7142" AutomationProperties.Name="Verificar y aplicar reglas">
          <TextBlock Text="VERIFICAR Y APLICAR" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
        </Grid>
        <Grid Margin="0,9,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="BtnRollback" Grid.Column="0" Style="{StaticResource Secondary}" AutomationProperties.Name="Restaurar Firewall AutoCAD con o sin archivos de respaldo">
          <TextBlock Text="RESTAURAR FIREWALL" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
         <TextBlock x:Name="FirewallHint" Grid.Column="1" Text="Aplicar requiere UAC y confirmación escrita." Style="{StaticResource Meta}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>
       </StackPanel>
      </Border>
     </TabItem>
     <TabItem Header="WebView2" AutomationProperties.Name="Análisis y monitor WebView2">
      <Border x:Name="WebCard" Background="White" Padding="6,10,6,0">
       <StackPanel>
        <TextBlock Text="Observa procesos y conexiones. No modifica el firewall." Style="{StaticResource Meta}" Margin="0,0,0,9"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="BtnAudit" Grid.Column="0" Style="{StaticResource Action}" AutomationProperties.Name="Analizar WebView2, solo lectura">
          <TextBlock Text="ANALIZAR WEBVIEW2" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
         <Button x:Name="BtnMonitor" Grid.Column="2" Style="{StaticResource Action}" Background="#354F9E" AutomationProperties.Name="Iniciar monitor WebView2">
          <TextBlock Text="INICIAR MONITOR" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
        </Grid>
        <Grid Margin="0,9,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="BtnStopMonitor" Grid.Column="0" Style="{StaticResource Secondary}" IsEnabled="False" AutomationProperties.Name="Detener monitor y guardar">
          <TextBlock Text="DETENER Y GUARDAR" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
         <TextBlock x:Name="MonitorHint" Grid.Column="1" Text="Solo lectura · máximo 10 minutos" Style="{StaticResource Meta}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,9,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="BtnGenericAutoCAD" Grid.Column="0" Style="{StaticResource Secondary}" AutomationProperties.Name="Bloqueo general de AutoCAD, sin analizar WebView2">
          <TextBlock Text="BLOQUEO GENERAL AUTOCAD" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
         <Button x:Name="BtnWebRestoreInfo" Grid.Column="2" Style="{StaticResource Secondary}" AutomationProperties.Name="Restaurar exclusivamente reglas historicas de WebView2 vinculadas a Autodesk, con confirmacion individual">
          <TextBlock Text="RESTAURAR WEBVIEW2 AUTODESK" TextWrapping="Wrap" TextAlignment="Center"/>
         </Button>
        </Grid>
        <TextBlock Text="El bloqueo general solo cubre AutoCAD. Restaurar WebView2 examina reglas históricas vinculadas a Autodesk; no elimina bloqueos genéricos." Style="{StaticResource Meta}" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
     </TabItem>
    </TabControl>
   </Border>

   <Border Grid.Row="8" Style="{StaticResource Card}" Padding="12,9">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Actividad" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14"/>
       <TextBlock x:Name="ActivityText" Text="Listo para consultar." Style="{StaticResource Meta}" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <TextBlock x:Name="Elapsed" Grid.Column="1" Text="00:00" FontFamily="Consolas" FontSize="17" Foreground="#315686" VerticalAlignment="Center"/>
     </Grid>
     <ProgressBar x:Name="Progress" Grid.Row="2" Height="7" Background="#E7EDF6" Foreground="#1677DC" IsIndeterminate="False" Value="0" BorderThickness="0"/>
    </Grid>
   </Border>

   <Expander x:Name="DetailsExpander" Grid.Row="10" IsExpanded="False" Background="White"
             AutomationProperties.Name="Mostrar detalles e informes">
    <Expander.Header>
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="Detalles e informes" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="13"/>
      <TextBlock x:Name="ResultTag" Text="SIN CAMBIOS" Foreground="#0B7142" Margin="13,0,0,0" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
    </Expander.Header>
    <TabControl x:Name="ResultTabs" Height="158" Margin="6" Background="White">
     <TabItem Header="AutoCAD">
      <TextBox x:Name="TxtFirewall" Background="#F5F8FD" BorderThickness="0" Padding="9" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="Analizar firewall comprueba ejecutables y reglas; no cambia Windows."/>
     </TabItem>
     <TabItem Header="WebView2">
      <TextBox x:Name="TxtWeb" Background="#F5F8FD" BorderThickness="0" Padding="9" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="La atribución probable no certifica aislamiento."/>
     </TabItem>
     <TabItem Header="Monitor">
      <TextBox x:Name="TxtMonitor" Background="#F5F8FD" BorderThickness="0" Padding="9" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="Monitor TCP/UDP observacional, no garantiza bloqueo total."/>
     </TabItem>
    </TabControl>
   </Expander>

   <Grid Grid.Row="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Herramienta local · sin cambios al consultar" Grid.Column="0" Foreground="#50627A" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
     <Button x:Name="BtnReports" Style="{StaticResource Secondary}" Margin="0,0,7,0" MinWidth="100" MinHeight="37" AutomationProperties.Name="Abrir informes">
      <TextBlock Text="Informes" TextAlignment="Center"/>
     </Button>
     <Button x:Name="BtnCancel" Style="{StaticResource Secondary}" Margin="0,0,7,0" MinWidth="110" MinHeight="37" IsEnabled="False" AutomationProperties.Name="Cancelar consulta">
      <TextBlock Text="Cancelar" TextAlignment="Center"/>
     </Button>
     <Button x:Name="BtnExit" Style="{StaticResource Secondary}" MinWidth="72" MinHeight="37" AutomationProperties.Name="Salir">
      <TextBlock Text="Salir" TextAlignment="Center"/>
     </Button>
    </WrapPanel>
   </Grid>
  </Grid>
 </ScrollViewer>
</Window>